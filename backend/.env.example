DATABASE_URL=mysql+pymysql://babyone:YOUR_DATABASE_PASSWORD@127.0.0.1:3306/babyone?charset=utf8mb4
# For managed hosts, set FIREBASE_SERVICE_ACCOUNT_JSON privately instead of a credential file.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=baby-one-a5cd4
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
ADMIN_FIREBASE_UIDS=
# Optional owner phone allowlist. Match only Firebase-verified +91 phone claims.
ADMIN_VERIFIED_PHONES=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Razorpay TEST keys only. Never commit actual values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional dedicated ₹10 test item. Requires valid Razorpay Test Mode keys.
ENABLE_TEST_CHECKOUT=false

# Optional WhatsApp Cloud API. All credential values stay server-side.
PUBLIC_STORE_URL=https://babyone-web-test.up.railway.app
CART_LINK_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_LANGUAGE=en_US
WHATSAPP_CART_TEMPLATE=babyone_cart_reminder
WHATSAPP_ORDER_TEMPLATE=babyone_order_update
